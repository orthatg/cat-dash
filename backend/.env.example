# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Any value left as CHANGE_ME is treated as "not configured" and that device is skipped.
#
# Passwords do NOT go in this file. Store them in the macOS Keychain:
#   uv run cat-dash-secrets set litterrobot
#   uv run cat-dash-secrets set petlibro
# (CATDASH_LITTERROBOT_PASSWORD / CATDASH_PETLIBRO_PASSWORD env vars still work as an
#  override, e.g. on a machine without a Keychain, but are not recommended.)

# --- Litter-Robot 4 (Whisker app account email) ---
CATDASH_LITTERROBOT_USERNAME=CHANGE_ME

# --- Petlibro (account created inside the Petlibro app, not via a web link) ---
# Logging in here can sign the phone app out. Prefer a second Petlibro account
# that the feeder is shared with, if the app lets you share it.
CATDASH_PETLIBRO_EMAIL=CHANGE_ME
# Region "US" is the only API host known to work (it serves all regions).
CATDASH_PETLIBRO_REGION=US

# --- Roomba i7+ (local network, MQTT port 8883; read-only) ---
# Robot IP: give it a DHCP reservation so it doesn't move.
CATDASH_ROOMBA_HOST=CHANGE_ME
# BLID = the robot's username (24 hex chars; it is in the robot's hostname Roomba-<BLID>).
CATDASH_ROOMBA_BLID=CHANGE_ME
# Password: store in the Keychain:  uv run cat-dash-secrets set roomba
# (get it once with the robot on its dock: hold HOME until it plays tones, then, from
#  backend/, run: uvx --from "roombapy[cli]" roombapy discover 192.168.1.50
#  using your robot's real IP). The robot allows ONE local connection, so close the
#  iRobot app first when fetching it.

# --- General ---
# IANA timezone of the house, used for Petlibro requests and "today" totals.
CATDASH_TIMEZONE=America/Chicago
CATDASH_PETLIBRO_POLL_SECONDS=60
CATDASH_LITTERROBOT_HISTORY_POLL_SECONDS=900
CATDASH_HOST=127.0.0.1
CATDASH_PORT=8000
