# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Any value left as CHANGE_ME is treated as "not configured" and that device is skipped.

# --- Litter-Robot 4 (Whisker app account) ---
CATDASH_LITTERROBOT_USERNAME=CHANGE_ME
CATDASH_LITTERROBOT_PASSWORD=CHANGE_ME

# --- Petlibro (account created inside the Petlibro app, not via a web link) ---
# Logging in here can sign the phone app out. Prefer a second Petlibro account
# that the feeder is shared with, if the app lets you share it.
CATDASH_PETLIBRO_EMAIL=CHANGE_ME
CATDASH_PETLIBRO_PASSWORD=CHANGE_ME
# Region "US" is the only API host known to work (it serves all regions).
CATDASH_PETLIBRO_REGION=US

# --- General ---
# IANA timezone of the house, used for Petlibro requests and "today" totals.
CATDASH_TIMEZONE=America/Chicago
CATDASH_PETLIBRO_POLL_SECONDS=60
CATDASH_LITTERROBOT_HISTORY_POLL_SECONDS=900
CATDASH_HOST=127.0.0.1
CATDASH_PORT=8000
